APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# For WAMP/XAMPP: use full path to public folder, e.g. http://localhost/Liba_ERP/public
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram bot (optional; Settings → Integrations overrides token/secret when set there)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_WEBHOOK_PATH=telegram/bot/webhook
# TELEGRAM_WELCOME_MESSAGE="Welcome to New Online Optics!"
# TELEGRAM_SHOP_URL=https://newonlineoptics.com/shop
# TELEGRAM_SHOP_BUTTON_TEXT="Open shop"
# TELEGRAM_SHOP_MENU_BUTTON_TEXT="Shop"


# Ecommerce storefront API
STOREFRONT_API_TOKEN=
STOREFRONT_BRANCH_ID=1
STOREFRONT_PAYMENT_TYPE_ID=
STOREFRONT_BANK_ACCOUNT_ID=


CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
# Optional: CHAPA_BASE_URL=https://api.chapa.co/v1

# SMS Ethiopia (ref + amount after paid shop orders)
SMSETHIOPIA_API_KEY=
# Optional: SMSETHIOPIA_BASE_URL=https://smsethiopia.com/api
SHOP_PRESCRIPTION_PRICE=800
SHOP_LENS_BLUE_CUT_PRICE=300
SHOP_LENS_ANTI_GLARE_PRICE=250
SHOP_BRAND_NAME="Liba Optics"

# Gemini prescription scan (in-app shop)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Banuba TINT virtual try-on (glasses) — paste merchant ID from Banuba
BANUBA_TINT_MERCHANT_ID=
BANUBA_CLIENT_TOKEN=

